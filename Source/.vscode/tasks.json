{
  "version": "2.0.0",
  "tasks": [
    { "label": "Mac: Build Debug", "type": "shell", "command": "xcodebuild",
      "args": ["-project", "${workspaceFolder}/../MacBuild/DelayCtrl/DelayCtrl.xcodeproj", "-configuration", "Debug", "build"],
      "group": { "kind": "build", "isDefault": true }, "problemMatcher": [] },
    { "label": "Mac: Build Release", "type": "shell", "command": "xcodebuild",
      "args": ["-project", "${workspaceFolder}/../MacBuild/DelayCtrl/DelayCtrl.xcodeproj", "-configuration", "Release", "build"],
      "group": "build", "problemMatcher": [] },
    { "label": "Win: Build Debug", "type": "shell", "command": "msbuild",
      "args": ["${workspaceFolder}/../WinBuild/vs/DelayCtrl.vcxproj", "/p:Configuration=Debug", "/p:Platform=x64", "/m", "/nologo"],
      "group": "build", "problemMatcher": "$msCompile" },
    { "label": "Win: Build Release", "type": "shell", "command": "msbuild",
      "args": ["${workspaceFolder}/../WinBuild/vs/DelayCtrl.vcxproj", "/p:Configuration=Release", "/p:Platform=x64", "/m", "/nologo"],
      "group": "build", "problemMatcher": "$msCompile" }
  ]
}
